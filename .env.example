# Copy this file to .env and fill in your Supabase project's connection
# details. .env is gitignored — never commit real credentials.
#
# Used by generate_trips_geojson.py and road_averaging.py (locally).
# The GitHub Action (.github/workflows/generate-trips.yml) reads the same
# values from repo Secrets instead — set them there for the scheduled run.

SUPABASE_HOST=host
SUPABASE_PORT=port
SUPABASE_DB=database
SUPABASE_USER=username
SUPABASE_PASSWORD=password